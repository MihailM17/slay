{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slay",
  "mainBinaryName": "slay-island",
  "version": "1.0.0",
  "identifier": "com.slay.island",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "python3 -m http.server 1420 --directory src",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Slay",
        "width": 1300,
        "height": 900
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
